# ─────────────────────────────────────────────────────────────
# Relay configuration. Copy to .env and adjust.
# Everything is optional for local development.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8787
PUBLIC_URL=http://localhost:8787
# REQUIRED in production: long random string (signs sessions, encrypts BYOK keys).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_SECRET=
# selfhost = all features unlocked, no billing | cloud = plan limits + Razorpay
RELAY_MODE=selfhost
ALLOW_SIGNUP=true
# Process role for scale-out (needs DATABASE_URL): all | web | worker. See docs/SCALING.md
RELAY_ROLE=all
JOB_CONCURRENCY=2

# Database: empty = embedded Postgres (PGlite) in DATA_DIR.
# Production: postgres://user:pass@host:5432/relay  (needs the pgvector extension)
DATABASE_URL=
# Optional CA certificate file for managed Postgres with a private CA (e.g. Aiven).
# Certificate and hostname verification stay enabled.
DATABASE_CA_CERT_FILE=
DATA_DIR=./data

# Platform default model (used by workspaces that haven't set BYOK).
# extractive = no LLM at all (free, offline). Others: anthropic | openai | gemini | groq | openrouter | ollama | openai-compatible
LLM_PROVIDER=extractive
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Embeddings: hash = built-in, offline, multilingual-lexical.
# openai-compatible = any /v1/embeddings endpoint, e.g. Ollama (EMBED_BASE_URL=http://localhost:11434/v1, EMBED_MODEL=bge-m3)
EMBED_PROVIDER=hash
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=

# Blob storage: empty = local disk in DATA_DIR. Any S3-compatible store (MinIO, Garage, R2, S3):
S3_ENDPOINT=
S3_BUCKET=relay
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Razorpay (Relay Cloud billing). Use test-mode keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# WhatsApp Cloud API: app secret verifies webhook signatures (per-workspace tokens are set in the dashboard).
WHATSAPP_APP_SECRET=

# Demo workspace "Kaapi & Co." (fictional store used by /demo). Test credentials for local use only.
DEMO_SEED=true
DEMO_EMAIL=demo@relay.local
DEMO_PASSWORD=relay-demo-1234

# Crawler/Actions may call private-network URLs (default: on in selfhost, off in cloud).
# ALLOW_PRIVATE_FETCH=true
USD_INR=88
