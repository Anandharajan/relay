FROM python:3.11-slim-bookworm AS build
ARG COLIBRI_REVISION=0a5504a1dc64f86fcd0fe7db298b0448c730e7e6
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /source
RUN git init && git remote add origin https://github.com/JustVugg/colibri.git && git fetch --depth 1 origin ${COLIBRI_REVISION} && git checkout --detach FETCH_HEAD
RUN make -C c -j2 colibri olmoe ARCH=x86-64-v3

FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=build /source/c /opt/colibri
WORKDIR /opt/colibri
ENV COLI_MODEL=/models/olmoe-q4 PYTHONUNBUFFERED=1
EXPOSE 8000
# No weights are downloaded and no model terms are accepted at startup.
ENTRYPOINT ["sh", "-c", "test -n \"$COLI_API_KEY\" || { echo 'Set COLIBRI_API_KEY before starting Colibri' >&2; exit 1; }; exec python /opt/colibri/coli serve --host 0.0.0.0 --port 8000 --model-id relay-olmoe --ngen 256 --ram 8"]
